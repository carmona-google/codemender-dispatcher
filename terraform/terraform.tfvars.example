# ==============================================================================
# Argolis GCP Deployment Variables Example
# Copy to terraform.tfvars (git-ignored) and populate with your Argolis values
# ==============================================================================

org_domain                  = "[YOUR_ARGOLIS_ORG_DOMAIN]"
admin_user                  = "[YOUR_ARGOLIS_ADMIN_USER]"
project_id                  = "[YOUR_ARGOLIS_PROJECT_ID]"
create_project              = false
region                      = "us-central1"
create_vpc                  = false
vpc_network_name            = "default"
vpc_subnetwork_name         = "default"
manage_argolis_org_policies = false
deploy_cloud_run            = true
dispatcher_image            = ""
