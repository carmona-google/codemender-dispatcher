{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.96.0",
          "rules": [
            {
              "id": "CWE-502",
              "name": "php.lang.security.audit.dynamic-call-user-func-wakeup",
              "shortDescription": {
                "text": "Dynamic callback execution via call_user_func() inside __wakeup() deserialization gadget"
              }
            },
            {
              "id": "CWE-209",
              "name": "php.lang.security.audit.information-disclosure-error-get-last",
              "shortDescription": {
                "text": "Exposure of internal error_get_last() backtrace and worker PID in HTTP response"
              }
            },
            {
              "id": "CWE-250",
              "name": "terraform.aws.security.iam.wildcard-resource-secretsmanager",
              "shortDescription": {
                "text": "IAM policy grants secretsmanager:GetSecretValue on wildcard ARN"
              }
            },
            {
              "id": "CWE-306",
              "name": "terraform.aws.security.apigateway.unauthenticated-route",
              "shortDescription": {
                "text": "API Gateway v2 route configured with authorization_type = NONE"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-502",
          "level": "error",
          "message": {
            "text": "php.lang.security.audit.dynamic-call-user-func-wakeup: Dynamic callback execution via call_user_func($this->auditHook, $this->stagingPath) inside TempUploadStagingBuffer::__wakeup() allows arbitrary code execution during session deserialization."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "codemender-cve-2026-test/app/upload.php"
                },
                "region": {
                  "startLine": 39,
                  "snippet": {
                    "text": "call_user_func($this->auditHook, $this->stagingPath);"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "CWE-209",
          "level": "warning",
          "message": {
            "text": "php.lang.security.audit.information-disclosure-error-get-last: Unredacted error_get_last() output in status.php leaks cross-request fatal error backtraces on persistent PHP-FPM workers."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "codemender-cve-2026-test/app/status.php"
                },
                "region": {
                  "startLine": 30,
                  "snippet": {
                    "text": "'last_error' => error_get_last(),"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "CWE-250",
          "level": "warning",
          "message": {
            "text": "terraform.aws.security.iam.wildcard-resource-secretsmanager: IAM Policy statement 'ReadApplicationSecrets' grants 'secretsmanager:GetSecretValue' on wildcard resource 'arn:aws:secretsmanager:us-east-1:000000000000:secret:genericcorp/prod/*'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "codemender-cve-2026-test/deploy/main.tf"
                },
                "region": {
                  "startLine": 68,
                  "snippet": {
                    "text": "Resource = \"arn:aws:secretsmanager:us-east-1:000000000000:secret:genericcorp/prod/*\""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "CWE-306",
          "level": "warning",
          "message": {
            "text": "terraform.aws.security.apigateway.unauthenticated-route: Route 'POST /upload.php' is configured with authorization_type = \"NONE\", allowing unauthenticated public access."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "codemender-cve-2026-test/deploy/main.tf"
                },
                "region": {
                  "startLine": 116,
                  "snippet": {
                    "text": "authorization_type = \"NONE\""
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
